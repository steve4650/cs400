#!/usr/bin/env bash

JUNITPATH="/libs/junit5.jar"

if [[ -f ${JUNITPATH} ]]; then
   cp ${JUNITPATH} ../
fi

if [[ ! -f pom.xml ]]; then
   echo
   echo "Submission Failed Check: no pom.xml found"
   exit 1
fi

if ! mvn compile ; then
   echo
   echo "Submission Failed Check: 'mvn compile' does not succeed"
   exit 1
fi

if [[ ! -f main/App.java ]]; then
   echo
   echo "Submission Failed Check: no main/App.java found"
   exit 1
fi

if grep -Pv '//' main/App.java | grep -Pq "_Placeholder"; then
    echo
    echo "Submission Failed Check: App.java includes references to Tree_Placeholder or Backend_Placeholder"
    exit 1
fi

echo
echo "Submission Passed Basic Scan"
exit 0
